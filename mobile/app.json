{
  "expo": {
    "name": "DC Opportunities",
    "slug": "dc-opportunities-mobile",
    "owner": "mcancillo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "com.dcopportunities.app",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1f33"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dcopportunities.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to center the map on nearby data-center opportunities.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          { "CFBundleURLSchemes": ["msauth.com.dcopportunities.app", "com.dcopportunities.app"] }
        ],
        "LSApplicationQueriesSchemes": ["msauthv2", "msauthv3"]
      }
    },
    "android": {
      "package": "com.dcopportunities.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1f33"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "INTERNET"]
    },
    "plugins": [
      "expo-secure-store",
      [
        "@maplibre/maplibre-react-native",
        {}
      ]
    ],
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" },
      "tenantId": "16b3c013-d300-468d-ac64-7eda0820b6d3",
      "mobileClientId": "3004922c-9d02-4d3e-8b22-8dd90c4bf78d",
      "apiScope": "api://0934e54f-36e2-4e8d-8aec-574895e062ef/access_as_user",
      "apiBaseUrl": "https://customer-m4b2vdcrzbbii-hhhtb7dfc0ecf5e9.b01.azurefd.net",
      "adminApiBaseUrl": "https://admin-m4b2vdcrzbbii-bpcvbueqhfbjbeef.b01.azurefd.net",
      "mapStyleUrl": "https://tiles.openfreemap.org/styles/liberty"
    }
  }
}
